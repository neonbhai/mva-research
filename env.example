# Example environment file. Copy to .env and fill in.
# NOTE: named without a leading dot on purpose -- `.env.*` is denied by
# .gitignore with no negation, so a dotted example file cannot be committed.
MVA_WORKSPACE=/absolute/path/outside/this/repo
TMPDIR=/absolute/path/outside/this/repo/tmp

# Where the out-of-repo PUBLIC reference releases live (gnomAD, ClinVar, the
# GRCh38 FASTA, MANE, SnpEff). Public data, not patient data -- but ~203 GB of
# it, so it must resolve OUTSIDE the repo and there is deliberately no default
# path: a guessed root that is wrong fails later, somewhere less obvious
# (ADR 0020). Pinned by knowledge/manifests/resources.yaml.
MVA_RESOURCES=/absolute/path/outside/this/repo/mva-resources
